# Required
TELNYX_API_KEY=KEY_YOUR_TELNYX_API_KEY

# Required unless TELNYX_VOICE_AUTO_PROVISION=true
# When auto-provision is enabled, these are created automatically.
# Get your connection ID from https://portal.telnyx.com/#/app/call-control/applications
TELNYX_VOICE_FROM_NUMBER=+15551234567
TELNYX_CALL_CONTROL_CONNECTION_ID=1234567890

# Auto-provision: set to true to create a Call Control app + order a
# phone number automatically when the adapter connects. Only
# TELNYX_API_KEY is required in this mode.
TELNYX_VOICE_AUTO_PROVISION=false

# Optional API configuration
TELNYX_VOICE_API_BASE=https://api.telnyx.com/v2
TELNYX_VOICE_WEBHOOK_URL=https://example.ngrok.app/webhooks/telnyx/voice

# Optional webhook listener configuration
TELNYX_VOICE_WEBHOOK_HOST=127.0.0.1
TELNYX_VOICE_WEBHOOK_PORT=8088
TELNYX_VOICE_WEBHOOK_PATH=/webhooks/telnyx/voice

# Webhook signature validation (recommended: leave enabled in production)
# Get your public key from https://portal.telnyx.com/#/app/account/public-key
# or GET https://api.telnyx.com/v2/public_key
TELNYX_PUBLIC_KEY=
# Set to true for production webhook signature validation
TELNYX_VOICE_REQUIRE_SIGNATURE=false
TELNYX_VOICE_SIGNATURE_TOLERANCE=300

# Authorization / cron delivery
TELNYX_VOICE_ALLOWED_USERS=+15551230001,+15551230002
TELNYX_VOICE_ALLOW_ALL_USERS=false
TELNYX_VOICE_HOME_CHANNEL=+15551230001

# Optional voice call behavior
TELNYX_VOICE_GREETING=Hello, you are connected to Hermes Agent.
TELNYX_VOICE_DEFAULT_VOICE=Telnyx.NaturalHD.astra
TELNYX_VOICE_LANGUAGE=en-US

# Live tests: all five must be set to make a real outbound call
TELNYX_VOICE_LIVE_TO_NUMBER=+15557654321
TELNYX_VOICE_LIVE_TEST=0
